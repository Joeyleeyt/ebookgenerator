# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Browser/edge-exposed copies (used by the web sign-in UI + middleware session refresh).
# Set these to the SAME values as SUPABASE_URL / SUPABASE_ANON_KEY above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Single administrator ───────────────────────────────────────────────────
# This is a single-admin app: only this email may sign in. Everyone else is
# rejected (401), even with a valid Supabase session. Provision the account with
# `pnpm admin:create` (reads ADMIN_EMAIL + ADMIN_PASSWORD below).
ADMIN_EMAIL=admin@example.com
# Only used by the `pnpm admin:create` script to set the initial password.
ADMIN_PASSWORD=change-me-strong-password

# ── Redis (BullMQ) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# How many books one user may generate at the same time. Projects run in
# parallel and the queue interleaves their jobs fairly; this bounds how many.
MAX_ACTIVE_PROJECTS_PER_USER=3

# ── Anthropic Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Total tokens-per-minute ceiling shared across all AI workers (token bucket)
ANTHROPIC_MAX_TPM=80000

# ── YouTube Data API ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-data-api-key

# ── YouTube proxies (transcript scraper + yt-dlp audio) ─────────────────────
# YouTube captcha/IP-blocks the transcript scraper and gates audio downloads
# when too many requests come from one IP. Route both through a rotating proxy
# pool to clear it. Use residential/mobile proxies — datacenter IPs are usually
# already flagged. Shared by the transcript fetch AND the yt-dlp audio path.
# Entries are comma- or newline-separated; each may be a full URL
# (http://user:pass@host:port / socks5://...) or the raw host:port:user:pass
# form — both are normalized. YT_DLP_PROXIES (pool) wins over YT_DLP_PROXY (one).
# YT_DLP_PROXY=http://user:pass@host:port
# YT_DLP_PROXIES=http://user:pass@host1:port,http://user:pass@host2:port

# ── OpenAI (Whisper audio fallback + gpt-image-1 cover illustrations) ───────
# Also used to generate the per-book cover art. If unset, books fall back to the
# plain typographic cover.
WHISPER_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── 69labs (in-chapter ILLUSTRATIONS) ───────────────────────────────────────
# https://69labs.vip — generates the in-chapter illustrations (async: generate →
# poll status → download). If unset, books simply carry no illustrations.
LABS69_API_KEY=vk_...
# Model for illustrations. Default "nano-banana-2": higher quality, ~38s/image,
# 1 credit. "img-flux" (Flux Schnell) is faster (~10s); "nano-banana-pro" is 2 credits.
LABS69_IMAGE_MODEL=nano-banana-2
# 69labs fails jobs from datacenter IPs (e.g. Railway). Route its requests through
# residential proxies via LABS69_PROXIES (same format as YT_DLP_PROXIES). If unset,
# it falls back to the YT_DLP_PROXIES pool, so a deployment with those needs nothing here.
# LABS69_PROXIES=http://user:pass@host1:port,http://user:pass@host2:port

# ── Netlify (sales landing pages) ──────────────────────────────────────────
# Hosts the generated sales page for a book. Create a token at
# Netlify → User settings → Applications → Personal access tokens.
# If unset, landing pages can still be written and previewed in the app — they
# just can't be published. Each published book creates its own Netlify site, so
# check the site limit on your plan.
# NETLIFY_AUTH_TOKEN=nfp_...
# Only needed when the token can see more than one Netlify team.
# NETLIFY_ACCOUNT_SLUG=your-team-slug

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
